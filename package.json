{
  "name": "@evefrontier/wallet-core",
  "version": "0.0.1-alpha.1",
  "description": "core signing classes for Eve Frontier wallets",
  "author": "",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./crypto": {
      "import": {
        "types": "./dist/crypto/index.d.mts",
        "default": "./dist/crypto/index.mjs"
      },
      "require": {
        "types": "./dist/crypto/index.d.cts",
        "default": "./dist/crypto/index.cjs"
      }
    },
    "./definitions": {
      "import": {
        "types": "./dist/definitions/index.d.mts",
        "default": "./dist/definitions/index.mjs"
      },
      "require": {
        "types": "./dist/definitions/index.d.cts",
        "default": "./dist/definitions/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./wallet-standard-extensions": {
      "import": {
        "types": "./dist/wallet-standard-extensions/index.d.mts",
        "default": "./dist/wallet-standard-extensions/index.mjs"
      },
      "require": {
        "types": "./dist/wallet-standard-extensions/index.d.cts",
        "default": "./dist/wallet-standard-extensions/index.cjs"
      }
    }
  },
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#tests/*": [
      "./tests/*",
      "./tests/*.ts",
      "./tests/*/index.ts"
    ]
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "pack": "bun run build && bun pm pack",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prepare": "./node_modules/.bin/husky"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evefrontier/wallet-core.git"
  },
  "bugs": {
    "url": "https://github.com/evefrontier/wallet-core/issues"
  },
  "homepage": "https://github.com/evefrontier/wallet-core/tree/main#readme",
  "packageManager": "bun@1.3.13",
  "overrides": {
    "axios": "^1.15.0",
    "lodash": ">=4.18.0",
    "protobufjs": ">=7.5.5"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mysten/signers": "^1.0.5",
    "@mysten/sui": "^2.16.3",
    "@mysten/wallet-standard": "^0.20.3"
  }
}
