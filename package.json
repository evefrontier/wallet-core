{
  "name": "@evefrontier/wallet-core",
  "version": "0.0.8",
  "description": "core signing classes for Eve Frontier wallets",
  "author": "",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./address-alias": {
      "types": "./dist/address-alias/index.d.mts",
      "import": "./dist/address-alias/index.mjs",
      "default": "./dist/address-alias/index.mjs"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.mts",
      "import": "./dist/crypto/index.mjs",
      "default": "./dist/crypto/index.mjs"
    },
    "./epoch": {
      "types": "./dist/epoch/index.d.mts",
      "import": "./dist/epoch/index.mjs",
      "default": "./dist/epoch/index.mjs"
    },
    "./eve-token": {
      "types": "./dist/eve-token/index.d.mts",
      "import": "./dist/eve-token/index.mjs",
      "default": "./dist/eve-token/index.mjs"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.mts",
      "import": "./dist/jwt/index.mjs",
      "default": "./dist/jwt/index.mjs"
    },
    "./sponsored-transaction": {
      "types": "./dist/sponsored-transaction/index.d.mts",
      "import": "./dist/sponsored-transaction/index.mjs",
      "default": "./dist/sponsored-transaction/index.mjs"
    },
    "./tenant": {
      "types": "./dist/tenant/index.d.mts",
      "import": "./dist/tenant/index.mjs",
      "default": "./dist/tenant/index.mjs"
    },
    "./transaction": {
      "types": "./dist/transaction/index.d.mts",
      "import": "./dist/transaction/index.mjs",
      "default": "./dist/transaction/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs",
      "default": "./dist/utils/index.mjs"
    },
    "./wallet-features": {
      "types": "./dist/wallet-features/index.d.mts",
      "import": "./dist/wallet-features/index.mjs",
      "default": "./dist/wallet-features/index.mjs"
    }
  },
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#tests/*": [
      "./tests/*",
      "./tests/*.ts",
      "./tests/*/index.ts"
    ]
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "clean": "rm -rf ./dist ./docs",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "docs": "typedoc",
    "docs:md": "typedoc --plugin typedoc-plugin-markdown --out docs/markdown",
    "docs:serve": "typedoc && bunx serve docs/api",
    "pack": "bun run build && bun pm pack",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run --browser.headless",
    "test:node": "vitest run --project unit-node",
    "test:browser": "vitest run --project unit-browser --project browser --browser.headless",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --browser.headless",
    "prepare": "./node_modules/.bin/husky"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evefrontier/wallet-core.git"
  },
  "bugs": {
    "url": "https://github.com/evefrontier/wallet-core/issues"
  },
  "homepage": "https://github.com/evefrontier/wallet-core/tree/main#readme",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mysten/sui": "^2.23.1",
    "@mysten/webcrypto-signer": "^0.1.2",
    "@mysten/wallet-standard": "^0.20.3",
    "@scure/bip39": "^2.2.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
  }
}
