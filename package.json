{
  "name": "@evefrontier/signer-core",
  "version": "0.0.1",
  "descrtiption": "",
  "author": "",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./crypto": "./src/crypto/index.ts",
    "./wallet-standard": "./src/wallet-standard/index.ts",
    "./definitions": "./src/definitions/index.ts"
  },
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#tests/*": [
      "./tests/*",
      "./tests/*.ts",
      "./tests/*/index.ts"
    ]
  },
  "files": [
    "LICENSE",
    "README.md",
    "src/crypto",
    "src/wallet-standard",
    "src/definitions"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "clean": "rm -rf tsconfig.tsbuildinfo",
    "build": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evefrontier/signer-core.git"
  },
  "bugs": {
    "url": "https://github.com/evefrontier/signer-core/issues"
  },
  "homepage": "https://github.com/evefrontier/signer-core/tree/main#readme",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "axios": "^1.15.0",
      "lodash": ">=4.18.0",
      "protobufjs": ">=7.5.5"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mysten/signers": "^1.0.2",
    "@mysten/sui": "^2.16.0",
    "@mysten/wallet-standard": "^0.20.1"
  }
}
