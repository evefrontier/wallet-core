{
  "name": "@evefrontier/wallet-core",
  "version": "0.0.1",
  "description": "core signing classes for Eve Frontier wallets",
  "author": "",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./crypto": "./src/crypto/index.ts",
    "./definitions": "./src/definitions/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./wallet-standard-extensions": "./src/wallet-standard-extensions/index.ts"
  },
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#tests/*": [
      "./tests/*",
      "./tests/*.ts",
      "./tests/*/index.ts"
    ]
  },
  "files": [
    "LICENSE",
    "README.md",
    "src/crypto",
    "src/definitions",
    "src/types",
    "src/utils",
    "src/wallet-standard-extensions"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "clean": "rm -rf tsconfig.tsbuildinfo",
    "build": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evefrontier/wallet-core.git"
  },
  "bugs": {
    "url": "https://github.com/evefrontier/wallet-core/issues"
  },
  "homepage": "https://github.com/evefrontier/wallet-core/tree/main#readme",
  "packageManager": "bun@1.3.13",
  "overrides": {
    "axios": "^1.15.0",
    "lodash": ">=4.18.0",
    "protobufjs": ">=7.5.5"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mysten/signers": "^1.0.2",
    "@mysten/sui": "^2.16.0",
    "@mysten/wallet-standard": "^0.20.1",
    "husky": "^9.1.7"
  }
}
